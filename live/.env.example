# Copy this file to .env (next to docker-compose.yml, or in this live/ folder on a PC) and fill it in.
# Never commit .env.

# ---------- required ----------
# YouTube Studio > Go live > Stream > Stream key, for the Gita Sarathi channel. (YOUTUBE_STREAM_KEY also works.)
YT_STREAM_KEY=
# The Gita Sarathi server (the website). Answers and voices come from it.
SARATHI_URL=https://parth-gita-assistant-1.onrender.com
# A long random secret; put the SAME value on Render as PARTH_LIVE_TOKEN, so the stream gets its own daily
# budgets. Make one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
LIVE_TOKEN=

# ---------- how it streams ----------
# cloud = render the vertical 1080x1920 stream ourselves and send it with ffmpeg (no OBS; the EscapeArenaLive
# way, for a 24/7 server or a PC). obs = show an overlay page that OBS streams.
# STREAM_MODE=cloud
# Resolution: auto picks 1080x1920 on 3+ CPU cores, otherwise 720x1280.
# SCALE=auto
# FPS=30
# Video bitrate in kbps (default 4500 at 1080x1920, 3000 at 720x1280)
# VIDEO_BITRATE_KBPS=4500
# X264_PRESET=veryfast
# YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
# Voice volume 0..1, and the optional background music (data/music.mp3) volume
# VOLUME=1.0
# MUSIC_VOLUME=0.12

# ---------- chat questions ----------
# The Google Cloud "Desktop app" OAuth client used once by youtube_auth.py (on a PC with a browser).
GOOGLE_CLIENT_SECRET=client_secret.json
# A message is a question when it contains one of these.
CHAT_TRIGGERS=@gitalive,!gita,#gitalive
# YouTube gives 10,000 API units a day; chat reading may use this many (5 units per read).
CHAT_DAILY_UNITS=9000
# At most this many viewer questions answered per hour.
ANSWERS_PER_HOUR=20

# ---------- recitation ----------
# New verse recordings per day (each is made once, then kept in data/cache for ever).
RECITE_TTS_PER_DAY=200
# Seconds a verse stays on screen when it has no recording yet.
SILENT_SECONDS=20
# 1 = ping the server every 10 minutes so the first question is fast (uses Render free hours).
KEEP_SERVER_AWAKE=0

# ---------- only for STREAM_MODE=obs ----------
# OBS > Tools > WebSocket Server Settings: enable, note the port and password.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_EXE=C:\Program Files\obs-studio\bin\64bit\obs64.exe
OVERLAY_PORT=8770
