# Copy this file to .env (in this live/ folder) and fill it in. Never commit .env.

# The Gita Sarathi server (the website). Answers and voices come from it.
SARATHI_URL=https://parth-gita-assistant-1.onrender.com
# A long random secret. Put the SAME value on Render as PARTH_LIVE_TOKEN, so the stream gets its own
# daily budgets and never uses up the website's. Make one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
LIVE_TOKEN=

# YouTube Studio > Go live > Stream > Stream key. Keep it secret.
YT_STREAM_KEY=
# The Google Cloud "Desktop app" OAuth client you downloaded (only used to read live chat).
GOOGLE_CLIENT_SECRET=client_secret.json

# OBS > Tools > WebSocket Server Settings: enable, note the port and password.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
# Where OBS is installed, so the autopilot can start it. (macOS: /Applications/OBS.app/Contents/MacOS/OBS)
OBS_EXE=C:\Program Files\obs-studio\bin\64bit\obs64.exe

# Chat: a message is a question when it contains one of these.
CHAT_TRIGGERS=@gitalive,!gita,#gitalive
# YouTube gives 10,000 API units a day; chat reading may use this many (5 units per read).
CHAT_DAILY_UNITS=9000
# At most this many viewer questions answered per hour.
ANSWERS_PER_HOUR=20
# New verse recordings per day (each is made once, then kept in live/cache forever).
RECITE_TTS_PER_DAY=200
# Seconds a verse stays on screen when it has no recording yet.
SILENT_SECONDS=20
# Local port for the overlay page OBS shows.
OVERLAY_PORT=8770
# 1 = ping the server every 10 minutes so the first question is fast (uses Render free hours).
KEEP_SERVER_AWAKE=0
